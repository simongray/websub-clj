{:paths ["src"]

 ;; Clojure 1.11 is the floor, and the tests run on it unless an alias says
 ;; otherwise. wary-fetch sends the requests, webcrypto-clj has the HMACs
 ;; of their signatures, qname-hiccup reads the links and the entries of a
 ;; feed, html-pieces reads the links of a page, and whatwg-url resolves the
 ;; URLs of both. whatwg-mime tells a feed from a page.
 :deps  {org.clojure/clojure        {:mvn/version "1.11.4"}
         dk.simongray/wary-fetch    {:mvn/version "0.16.1"}
         dk.simongray/webcrypto-clj {:mvn/version "0.1.3"}
         dk.simongray/qname-hiccup  {:mvn/version "0.6.1"}
         dk.simongray/html-pieces   {:mvn/version "0.8.0"}
         dk.simongray/whatwg-url    {:mvn/version "0.1.0"}
         dk.simongray/whatwg-mime   {:mvn/version "0.2.2"}}

 :aliases
 {;; clojure -X:test
  :test {:extra-paths ["test"]
         :extra-deps  {io.github.cognitect-labs/test-runner
                       {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts   ["-m" "cognitect.test-runner"]
         :exec-fn     cognitect.test-runner.api/test}

  ;; clojure -M:cljs compile test  (the tests in Node)
  :cljs {:extra-paths   ["test"]
         :override-deps {org.clojure/clojure {:mvn/version "1.12.6"}}
         :extra-deps    {thheller/shadow-cljs {:mvn/version "3.5.8"}}
         :main-opts     ["-m" "shadow.cljs.devtools.cli"]}

  ;; clojure -T:build jar | install | deploy  (see build.clj)
  :build {:deps       {io.github.clojure/tools.build {:mvn/version "0.10.14"}
                       slipset/deps-deploy            {:mvn/version "0.2.5"}}
          :ns-default build}}}
